---
import Badge from '../components/Badge.astro';


type PlaceholderMember = {
  name: string;
  website: string;
  img: string;
};

type PageringMember = {
  id: string;
  name: string;
  url: string;
  redirectUrl: string;
  buttonUrl: string;
};

const [placeholderRes, pageringRes] = await Promise.all([
  fetch("https://webring.phthallo.com/api/members"),
  fetch("https://pagering.gideon.sh/api/v1/members"),
]);

const placeholder: PlaceholderMember[] = await placeholderRes.json();
const pagering: PageringMember[] = await pageringRes.json();
